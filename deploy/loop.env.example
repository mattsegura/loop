# /etc/loop/loop.env (root:loop 0640)
NODE_ENV=production
LOOP_HOSTED=1
LOOP_HUB_PORT=8799
LOOP_HUB_DATA=/var/lib/loop/data
# Optional override for downloadable release tarballs + release.json (defaults to ../releases next to app):
# LOOP_RELEASES_DIR=/opt/loop/releases
LOOP_PUBLIC_ORIGIN=https://useloop.sh
LOOP_HUB_ALLOWED_HOSTS=useloop.sh
LOOP_TRUST_PROXY=1
LOOP_NO_AGENT_HOOKS=1
LOOP_NO_OPEN=1
LOOP_MAX_OAUTH_CLIENTS=10000
# Agents ask each person before they send feedback about Loop to you (docs/agent-feedback.md). This turns it off for everybody:
# LOOP_AGENT_FEEDBACK=off
# Semantic search: local Xenova/bge-base-en-v1.5 model (runtime: npm install @huggingface/transformers in /opt/loop/search-runtime)
LOOP_EMBEDDING_PROVIDER=local
LOOP_SEARCH_RUNTIME_DIR=/opt/loop/search-runtime
LOOP_SEARCH_MODEL_CACHE=/var/lib/loop/search-models
# Search v3 settings with their defaults. Reranking is opt-in: local runs a model on this server,
# llm sends each query and its top results to LOOP_RERANK_URL.
# LOOP_SEARCH_STRATEGY=hybrid
# LOOP_SEARCH_SKILL_BODIES=1
# LOOP_SEARCH_ENRICHMENT=
# LOOP_RERANK_PROVIDER=off
# LOOP_RERANK_URL=
# LOOP_RERANK_API_KEY=
# LOOP_RERANK_MODEL=
# LOOP_RERANK_DEPTH=20
# Clerk production instance for useloop.sh (publishable key only)
CLERK_PUBLISHABLE_KEY=pk_live_replace_me
