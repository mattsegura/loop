# Loop — Environment Configuration
# Local Loop runs out of the box with zero configuration (`npm install && npm start`)
# on 127.0.0.1:8799 with local password auth and never connects to Loop Cloud.
# Copy this file to .env.local only if you want to customize ports/paths or host Loop Cloud.

# Hosted / Loop Cloud (`LOOP_HOSTED=1`) configuration:
# Set LOOP_HOSTED=1 and CLERK_PUBLISHABLE_KEY only when running a hosted multi-user Loop Cloud server.
# LOOP_HOSTED=1
# CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key

# Optional: Comma-separated allowlist of public HTTPS origins for hosted workspaces (e.g. https://mcp.example.com)
# LOOP_TRUSTED_MCP_ORIGINS=

# Optional: Local listen port (default: 8799)
# LOOP_HUB_PORT=8799

# Optional: Override data directory for config.json, vault.json, vault.key, activity.jsonl
# LOOP_HUB_DATA=

# Optional: Extra host:port values accepted by Host header check (e.g. Tailscale hostname)
# LOOP_HUB_ALLOWED_HOSTS=

# Optional: Agent hook startup behavior (LOOP_AGENT_HOOKS=1 to auto-install, LOOP_NO_AGENT_HOOKS=1 to disable)
# LOOP_AGENT_HOOKS=
# LOOP_NO_AGENT_HOOKS=

# Optional: Set to 1 to skip opening the browser when running ./start.command
# LOOP_NO_OPEN=1

# Optional: Stripe billing (hosted deployments only — leave unset when self-hosting;
# self-hosted local installs never hit paywalls)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...           # Loop Connect ($12/mo, includes 2 connected devices)
# STRIPE_EXTRA_DEVICE_PRICE_ID=price_...  # Additional device add-on (+$5/device/mo beyond 2 devices)
# STRIPE_TEAM_PRICE_ID=price_...

# Optional: Semantic search add-on (works cleanly without these using built-in lexical search)
# LOOP_EMBEDDING_PROVIDER=auto            # off | auto | local | ollama | http
# LOOP_EMBEDDING_MODEL=Xenova/bge-base-en-v1.5
# LOOP_SEMANTIC_MIN_TOOLS=50              # Auto-mode split: stay 0-MB lexical below this, auto-activate semantic at/above it
#                                         # (also at 6 Connections, 50 Skills or 50 memories; 0 = semantic at every size)
# LOOP_EMBEDDING_URL=                     # Shared hosted TEI / OpenAI-compatible embeddings endpoint
# LOOP_EMBEDDING_API_KEY=
# LOOP_OLLAMA_URL=http://127.0.0.1:11434
# LOOP_SEARCH_RUNTIME_DIR=                # Optional on-demand local @huggingface/transformers dir
# LOOP_SEARCH_MODEL_CACHE=                # Optional dir for downloaded local models
# LOOP_SEARCH_STRATEGY=hybrid             # hybrid | cascade (older)
# LOOP_SEARCH_SKILL_BODIES=1              # 0 = no vectors for Skill bodies, only for names and descriptions
# LOOP_SEARCH_ENRICHMENT=                 # Optional file from scripts/enrich-hub.mjs (default: search-enrichment.json in the data dir)
# LOOP_RERANK_PROVIDER=off                # off | local | llm (llm sends each query and its top results to LOOP_RERANK_URL)
# LOOP_RERANK_URL=                        # OpenAI-compatible base URL for llm (Loop adds /chat/completions)
# LOOP_RERANK_API_KEY=
# LOOP_RERANK_MODEL=                      # Default: deepseek-chat (llm) or Xenova/bge-reranker-base (local)
# LOOP_RERANK_DEPTH=20                    # How many top results to rerank (at most 50)

# Optional: Loop Text SMS / iMessage agent bridge (localhost service)
# LOOP_TEXT_URL=http://127.0.0.1:8810
# LOOP_TEXT_INTERNAL_SECRET=
# LOOP_TEXT_PHONE=


